#include <iostream>
using namespace std;

int main() {
    int n;
    float sum = 0.0, average;
    cout << "Enter the size of the array: ";
    cin >> n;

    int arr[n];
    cout << "Enter the elements of the array: ";
    for (int i = 0; i < n; ++i) {
        cin >> arr[i];
    }
    for (int i = 0; i < n; ++i) {
        sum += arr[i];
    }
    average = sum / n;
    cout << "The average of all elements in the array is: " << average << endl;

    return 0;
}
